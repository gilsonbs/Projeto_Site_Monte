---
import { getCollection, getEntry } from 'astro:content';

// 1. Buscando os dados dinâmicos das coleções
const todosPosts = await getCollection('posts');
const todasCategorias = await getCollection('categorias');

// Buscando o arquivo de configurações globais (assumindo que o nome do arquivo seja 'index.json')
const configEntry = await getEntry('configuracoes', 'index');
const config = configEntry?.data || {};

// Mapeando dados do Tina CMS (com fallbacks de segurança caso o painel esteja vazio)
const nomeSite = config.nomeSite || "Monte das Oliveiras";
const urlLogo = config.logoUrl || "";
const activarAnuncios = config.activarAnuncios || false;
const publisherId = config.googlePublisherId || "";
const slotLateral = config.googleSlotLateral || "";
const slotHero = config.googleSlotHero || "";

const corFundo = "#f8fafc";

// Pegar os posts mais recentes para o destaque superior
const postsRecentes = todosPosts.slice(0, 3);
---

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{nomeSite} | Portal de Notícias</title>
    <style define:vars={{ corFundo }}>
        body {
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--corFundo);
            margin: 0; padding: 0; color: #0f172a;
        }
        .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
        
        /* --- HEADER --- */
        .header-topo { background: #ffffff; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); position: sticky; top: 0; z-index: 100; border-bottom: 1px solid #e2e8f0; }
        .header-container { display: flex; align-items: center; justify-content: space-between; height: 75px; }
        .logo a { font-size: 1.6rem; font-weight: 800; color: #1e3a8a; text-decoration: none; display: flex; align-items: center; letter-spacing: -0.025em; }
        .logo img { height: 50px; width: auto; object-fit: contain; }
        .menu-navegacao { display: flex; gap: 24px; list-style: none; margin: 0; padding: 0; }
        .menu-navegacao a { text-decoration: none; color: #475569; font-weight: 600; font-size: 0.9rem; transition: all 0.2s; text-transform: uppercase; }

        /* --- HERO PREMIUM --- */
        .hero-secao { padding: 30px 0; background: #ffffff; border-bottom: 1px solid #e2e8f0; }
        .hero-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
        @media (min-width: 992px) { .hero-grid { grid-template-columns: 1.6fr 1fr; } }
        
        .hero-link { position: relative; border-radius: 12px; overflow: hidden; display: block; text-decoration: none; background: #0f172a; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); }
        .hero-principal { aspect-ratio: 16/10; }
        @media (min-width: 992px) { .hero-principal { height: 100%; } }
        
        .hero-link img { width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; transition: transform 0.5s; }
        .hero-link:hover img { transform: scale(1.04); }
        .hero-degrafe { position: absolute; inset: 0; background: linear-gradient(to top, rgba(15, 23, 42, 0.95) 0%, rgba(15, 23, 42, 0.4) 50%, transparent 100%); z-index: 1; }
        .hero-conteudo { position: absolute; bottom: 0; left: 0; right: 0; padding: 24px; z-index: 2; color: #ffffff; }
        .badge-tag { background: #2563eb; color: white; padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; margin-bottom: 12px; display: inline-block; }
        .hero-conteudo h2 { margin: 0 0 10px 0; font-size: 1.5rem; font-weight: 700; line-height: 1.2; }
        @media (min-width: 768px) { .hero-conteudo h2 { font-size: 2.2rem; } }
        
        .hero-lateral-lista { display: flex; flex-direction: column; gap: 15px; } /* Ajustado gap para caber o anúncio */
        .hero-secundario { aspect-ratio: 16/7; min-height: 140px; }
        .hero-secundario h3 { margin: 0; font-size: 1.1rem; font-weight: 700; }

        /* --- ANÚNCIO NO MEIO DO HERO --- */
        .ad-hero-middle {
            width: 100%;
            height: 100px;
            background: #f1f5f9;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px dashed #cbd5e1;
            overflow: hidden;
        }

        /* --- CATEGORIAS --- */
        .secao-categoria { margin-top: 40px; margin-bottom: 40px; background: #ffffff; padding: 24px; border-radius: 12px; border: 1px solid #e2e8f0; }
        .titulo-categoria { font-size: 1.25rem; border-left: 4px solid #2563eb; padding-left: 12px; margin-bottom: 24px; text-transform: uppercase; color: #1e3a8a; font-weight: 800; }
        .grid-noticias { display: grid; grid-template-columns: 1fr; gap: 24px; }
        @media (min-width: 768px) { .grid-noticias { grid-template-columns: 2fr 1fr; } }
        
        .post-link { text-decoration: none; color: inherit; display: block; }
        .post-destaque img { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-radius: 8px; }
        .post-destaque h3 { font-size: 1.5rem; margin: 16px 0 10px 0; font-weight: 700; }
        
        .item-miniatura { display: flex; gap: 16px; align-items: center; text-decoration: none; color: inherit; border-bottom: 1px solid #f1f5f9; padding-bottom: 16px; }
        .item-miniatura img { width: 80px; height: 80px; object-fit: cover; border-radius: 8px; flex-shrink: 0; }
        .item-miniatura h4 { margin: 0; font-size: 0.95rem; font-weight: 700; line-height: 1.4; }

        /* --- ESTRUTURA DE ANÚNCIOS LATERAIS --- */
        .layout-com-anuncios { display: flex; justify-content: center; align-items: flex-start; gap: 20px; max-width: 1600px; margin: 0 auto; }
        .conteudo-principal-portal { flex: 1; max-width: 1200px; min-width: 0; }
        .anuncio-lateral-fixo { display: none; width: 160px; position: sticky; top: 95px; z-index: 50; }
        @media (min-width: 1400px) { .anuncio-lateral-fixo { display: block; } }
        .container-adsense-vertical { width: 100%; min-height: 600px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #ffffff; border: 1px dashed #cbd5e1; border-radius: 8px; }
        .ads-label { font-size: 0.6rem; color: #94a3b8; text-transform: uppercase; margin-bottom: 4px; font-weight: 600; }
    </style>
</head>
<body>

    <header class="header-topo">
        <div class="container header-container">
            <div class="logo">
                <a href="/">
                    {urlLogo ? <img src={urlLogo} alt={nomeSite} /> : <span>{nomeSite}</span>}
                </a>
            </div>
            <nav>
                <ul class="menu-navegacao">
                    <li><a href="/">Início</a></li>
                    {todasCategorias.map((cat) => {
                        const catId = cat.id.split('/').pop()?.replace('.json', '');
                        return (<li><a href={`/categoria/${catId}`}>{cat.data.title}</a></li>);
                    })}
                </ul>
            </nav>
        </div>
    </header>

    <div class="layout-com-anuncios">

        {activarAnuncios && slotLateral && (
            <aside class="anuncio-lateral-fixo">
                <div class="container-adsense-vertical">
                    <span class="ads-label">Publicidade</span>
                    <div style="font-size: 0.7rem; color: #cbd5e1; text-align: center;">Skyscraper<br>{slotLateral}</div>
                </div>
            </aside>
        )}

        <main class="conteudo-principal-portal">

            {postsRecentes.length > 0 && (
                <section class="hero-secao">
                    <div class="container hero-grid">
                        <a href={`/posts/${postsRecentes[0].id}`} class="hero-link hero-principal">
                            <img src={postsRecentes[0].data.imagemDestaque} alt={postsRecentes[0].data.altText} />
                            <div class="hero-degrafe"></div>
                            <div class="hero-conteudo">
                                <span class="badge-tag">Destaque</span>
                                <h2>{postsRecentes[0].data.title}</h2>
                                <p style="color: #cbd5e1; font-size: 0.9rem;">{postsRecentes[0].data.metaDescription}</p>
                            </div>
                        </a>

                        <div class="hero-lateral-lista">
                            {/* Primeiro post secundário */}
                            {postsRecentes[1] && (
                                <a href={`/posts/${postsRecentes[1].id}`} class="hero-link hero-secundario">
                                    <img src={postsRecentes[1].data.imagemDestaque} alt={postsRecentes[1].data.altText} />
                                    <div class="hero-degrafe"></div>
                                    <div class="hero-conteudo">
                                        <h3>{postsRecentes[1].data.title}</h3>
                                    </div>
                                </a>
                            )}

                            {/* ANÚNCIO ENTRE OS POSTS DO HERO */}
                            {activarAnuncios && slotHero && (
                                <div class="ad-hero-middle">
                                    <div style="text-align: center;">
                                        <span class="ads-label">Publicidade</span>
                                        <div style="font-size: 0.7rem; color: #cbd5e1;">Banner Hero: {slotHero}</div>
                                    </div>
                                </div>
                            )}

                            {/* Segundo post secundário */}
                            {postsRecentes[2] && (
                                <a href={`/posts/${postsRecentes[2].id}`} class="hero-link hero-secundario">
                                    <img src={postsRecentes[2].data.imagemDestaque} alt={postsRecentes[2].data.altText} />
                                    <div class="hero-degrafe"></div>
                                    <div class="hero-conteudo">
                                        <h3>{postsRecentes[2].data.title}</h3>
                                    </div>
                                </a>
                            )}
                        </div>
                    </div>
                </section>
            )}

            <div class="container">
                {todasCategorias.map((cat) => {
                    const currentCatId = cat.id.split('/').pop()?.replace('.json', '').replace('.mdx', '').trim().toLowerCase();
                    const postsDaCategoria = todosPosts.filter(post => {
                        const postCatRaw = post.data.categoria?.id || post.data.categoria || '';
                        const postCatId = String(postCatRaw).split('/').pop()?.replace('.json', '').replace('.mdx', '').trim().toLowerCase();
                        return postCatId === currentCatId;
                    });
                    
                    if (postsDaCategoria.length === 0) return null;

                    return (
                        <section class="secao-categoria">
                            <h2 class="titulo-categoria">{cat.data.title}</h2>
                            <div class="grid-noticias">
                                <a href={`/posts/${postsDaCategoria[0].id}`} class="post-link">
                                    <article class="post-destaque">
                                        <img src={postsDaCategoria[0].data.imagemDestaque} />
                                        <h3>{postsDaCategoria[0].data.title}</h3>
                                        <p style="color: #475569; font-size: 0.9rem;">{postsDaCategoria[0].data.metaDescription}</p>
                                    </article>
                                </a>
                                <div class="lista-lateral">
                                    {postsDaCategoria.slice(1, 4).map((p) => (
                                        <a href={`/posts/${p.id}`} class="item-miniatura">
                                            <img src={p.data.imagemDestaque} />
                                            <h4>{p.data.title}</h4>
                                        </a>
                                    ))}
                                </div>
                            </div>
                        </section>
                    );
                })}
            </div>
        </main>

        {activarAnuncios && slotLateral && (
            <aside class="anuncio-lateral-fixo">
                <div class="container-adsense-vertical">
                    <span class="ads-label">Publicidade</span>
                    <div style="font-size: 0.7rem; color: #cbd5e1; text-align: center;">Skyscraper<br>{slotLateral}</div>
                </div>
            </aside>
        )}

    </div>
</body>
</html>