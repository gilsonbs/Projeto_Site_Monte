---
import { getCollection, render, getEntry } from 'astro:content';

// 1. ESSENCIAL: Gera os caminhos para o Astro encontrar os posts
export async function getStaticPaths() {
  const todosPosts = await getCollection('posts');
  return todosPosts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Busca as configurações globais do painel
const configEntry = await getEntry('configuracoes', 'index');
const config = configEntry?.data || {};

const nomeSite = config.nomeSite || "Monte das Oliveiras";
const urlLogo = config.logoUrl || "";
const activarAnuncios = config.activarAnuncios || false;
const slotLateral = config.googleSlotLateral || "";

const corFundo = "#f8fafc"; 
---

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{post.data.title} | {nomeSite}</title>
    
    <style define:vars={{ corFundo }} is:global>
        /* RESET DE BOX-MODEL */
        * {
            box-sizing: border-box !important;
        }

        body { 
            font-family: system-ui, -apple-system, sans-serif; 
            background-color: var(--corFundo); 
            margin: 0; padding: 0;
            overflow-x: hidden;
        }

        /* --- BLINDAGEM GLOBAL DE IMAGENS --- */
        /* Isso afeta até o que vem do Tina/MDX */
        img, figure, picture, .conteudo-artigo img {
            max-width: 100% !important;
            height: auto !important;
            display: block !important;
            margin: 20px auto !important;
            border-radius: 8px;
        }

        .layout-geral {
            display: flex;
            justify-content: center;
            gap: 20px;
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        .coluna-principal {
            flex: 1;
            min-width: 0; /* Impede a coluna de esticar */
            width: 100%;
        }

        .container-artigo {
            width: 100%;
            max-width: 850px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 10px rgba(0,0,0,0.03);
        }

        @media (min-width: 768px) {
            .container-artigo { padding: 50px; }
        }

        /* HEADER */
        .header-topo { background: #ffffff; border-bottom: 1px solid #e2e8f0; padding: 15px 0; text-align: center; margin-bottom: 20px; }
        .logo-link { font-size: 1.5rem; font-weight: 800; color: #1e3a8a; text-decoration: none; }
        .logo-img { height: 45px; width: auto; object-fit: contain; }

        /* ANÚNCIOS LATERAIS */
        .anuncio-lateral { display: none; width: 160px; flex-shrink: 0; position: sticky; top: 100px; }
        @media (min-width: 1300px) { .anuncio-lateral { display: block; } }
        
        .box-adsense { 
            width: 100%; min-height: 600px; 
            background: #fff; border: 1px dashed #ccc; 
            display: flex; flex-direction: column; align-items: center; justify-content: center; 
        }

        /* CONTEÚDO */
        .voltar { display: inline-block; margin-bottom: 25px; color: #2563eb; text-decoration: none; font-weight: 600; }
        h1 { font-size: 2.4rem; line-height: 1.1; margin-bottom: 20px; color: #0f172a; letter-spacing: -0.02em; }
        .conteudo-artigo { font-size: 1.15rem; line-height: 1.8; color: #1e293b; }
        .conteudo-artigo p { margin-bottom: 25px; }
    </style>
</head>
<body>

    <header class="header-topo">
        <a href="/" class="logo-link">
            {urlLogo ? <img src={urlLogo} alt={nomeSite} class="logo-img" /> : <span>{nomeSite}</span>}
        </a>
    </header>

    <div class="layout-geral">
        
        {activarAnuncios && (
            <aside class="anuncio-lateral">
                <div class="box-adsense">
                    <span style="font-size: 10px; color: #999;">PUBLICIDADE</span>
                    <div style="font-size: 11px; color: #cbd5e1; text-align: center; padding: 10px;">Lateral Esquerda<br>{slotLateral}</div>
                </div>
            </aside>
        )}

        <main class="coluna-principal">
            <div class="container-artigo">
                <a href="/" class="voltar">← Voltar para o portal</a>
                
                <article>
                    <h1>{post.data.title}</h1>
                    
                    {/* Imagem de Destaque principal do post */}
                    <img 
                        src={post.data.imagemDestaque} 
                        alt={post.data.altText} 
                        style="width: 100%; aspect-ratio: 16/9; object-fit: cover;"
                    />
                    
                    <div class="conteudo-artigo">
                        <Content />
                    </div>
                </article>
            </div>
        </main>

        {activarAnuncios && (
            <aside class="anuncio-lateral">
                <div class="box-adsense">
                    <span style="font-size: 10px; color: #999;">PUBLICIDADE</span>
                    <div style="font-size: 11px; color: #cbd5e1; text-align: center; padding: 10px;">Lateral Direita<br>{slotLateral}</div>
                </div>
            </aside>
        )}

    </div>

</body>
</html>